---
import { load } from 'cheerio';
import Registration from '../components/Registration.astro';
import { isLocalSite } from '../../config/site.mjs';
import { games } from '../../config/games.mjs';
import { profile, projects } from '../config';

interface Props { source: string; slug: string; }
const { source, slug } = Astro.props;
const game = games.find((item) => item.slug === slug);
const project = projects.find((item) => item.slug === slug);
if (!game || !project) throw new Error(`Game registration missing: ${slug}`);

// The standalone game owns its HTML and logic. Adapt its document at build time;
// keep its relative module/audio URLs together under the stable asset directory.
const $ = load(source);
if ($('head').length !== 1 || $('#board').length !== 1 || $('.credits').length !== 1) {
  throw new Error('The standalone game document changed; review its blog integration.');
}
for (const node of $('[src], [href]').toArray()) {
  for (const attribute of ['src', 'href']) {
    const value = $(node).attr(attribute);
    if (value?.startsWith('./')) $(node).attr(attribute, `${game.assetPath}${value.slice(2)}`);
  }
}
// Standalone builds link to the live site; integrated builds stay on their own origin.
for (const node of $('a[data-project-link]').toArray()) {
  const target = games.find((item) => item.slug === $(node).attr('data-project-link'));
  if (!target) throw new Error(`Unknown game cross-link in ${slug}`);
  $(node).attr('href', target.pagePath);
}
$('.credits').prepend('<p><a href="/projects/">← 所有交互作品</a></p>');
const canonical = new URL(game.pagePath, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <Fragment set:html={$('head').html()} />
    <link rel="canonical" href={canonical} />
    {isLocalSite && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={profile.title} />
    <meta property="og:title" content={project.title} />
    <meta property="og:description" content={project.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(project.cover.src, Astro.site)} />
  </head>
  <body data-game={slug}>
    <Fragment set:html={$('body').html()} />
    <footer class="game-site-footer">
      <a class="game-back-link" href="/projects/" aria-label="返回交互作品列表">← 作品</a>
      <Registration />
    </footer>
  </body>
</html>
<style is:global>
  body { display: grid; grid-template-rows: minmax(0, 1fr) auto; height: 100%; height: 100dvh; }
  .game { height: 100%; min-height: 0; }
  .app { height: 100%; }
  .game-site-footer { position: relative; padding: 6px max(64px, env(safe-area-inset-right)) max(6px, env(safe-area-inset-bottom)) max(64px, env(safe-area-inset-left)); background: var(--panel); color: var(--muted, #626457); border-top: 1px solid var(--line); }
  .game-back-link { position: absolute; left: max(12px, env(safe-area-inset-left)); top: 6px; color: inherit; font-size: .75rem; line-height: 1.6; text-decoration: none; }
  .game-back-link:hover { text-decoration: underline; }
  .game-back-link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .credits a { color: var(--mint, var(--green)); text-underline-offset: .2em; }
  @media (max-width: 760px) {
    /* Keep the footer after the game's intrinsic height, including controls
       that wrap on narrow phones; short screens can scroll to every action. */
    body[data-game="conway-soldiers-3d"] { display: flex; flex-direction: column; overflow: auto; }
    body[data-game="conway-soldiers-3d"] .app { height: auto; flex: 1 0 auto; }
    /* Canvas backing dimensions must not enlarge the flex content on resize. */
    body[data-game="conway-soldiers-3d"] #board { position: absolute; inset: 0; }
    body[data-game="conway-soldiers-3d"] .game-site-footer { flex-shrink: 0; }
  }
</style>
