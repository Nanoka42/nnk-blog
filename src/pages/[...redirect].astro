---
import RedirectPage from '../components/RedirectPage.astro';
import { redirectPaths, redirects } from '../../config/redirects.mjs';
export function getStaticPaths() {
  return redirectPaths.map((redirect) => ({ params: { redirect }, props: { target: redirects[`/${redirect}/`] } }));
}
const { target } = Astro.props;
---
<RedirectPage target={target} />
