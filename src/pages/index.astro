---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects } from '../config';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, 3);
---
<BaseLayout>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-copy"><p class="eyebrow">NANOKA'S NOTEBOOK</p><h1 id="home-title">毋待培风九万里，<br /><span>微羽逍遥千林中。</span></h1><p class="hero-bio">{profile.bio}</p><div class="hero-links"><a class="button" href="/posts/">所有文章 <span aria-hidden="true">→</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={profile.bilibili} target="_blank" rel="noopener noreferrer">Bilibili ↗</a></div></div>
    <div class="portrait"><div class="portrait-frame"><Image src={profile.avatar} alt="真理院七叶的紫发猫耳角色头像" widths={[320, 480, 640]} sizes="(max-width: 600px) 180px, 320px" width={480} format="webp" loading="eager" fetchpriority="high" /></div><p><span class="portrait-star" aria-hidden="true">✳</span> 真理院七叶 <span>/ Shinriin Nanoka</span></p></div>
  </section>
  <section class="home-section" aria-labelledby="selected-title"><div class="section-heading"><div><span class="eyebrow">INTERACTIVE WORKS</span><h2 id="selected-title">最近交互作品</h2></div><a class="text-link" href="/projects/">全部交互作品 <span aria-hidden="true">↗</span></a></div>{projects.map((project) => <ProjectCard project={project} headingLevel="h3" />)}</section>
  <section class="home-section" aria-labelledby="recent-title"><div class="section-heading"><div><span class="eyebrow">ARTICLES</span><h2 id="recent-title">最近文章</h2></div><a class="text-link" href="/posts/">全部文章 <span aria-hidden="true">↗</span></a></div><div class="post-list">{posts.map((post) => <PostCard post={post} headingLevel="h3" />)}</div></section>
</BaseLayout>
