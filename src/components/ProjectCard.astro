---
import { Image } from 'astro:assets';
import { projects } from '../config';
interface Props { project: (typeof projects)[number]; headingLevel?: 'h2' | 'h3'; }
const { project, headingLevel: Heading = 'h2' } = Astro.props;
---
<article class="project-card">
  <a class="project-cover" href={`/projects/${project.slug}/`} tabindex="-1" aria-hidden="true"><Image src={project.cover} alt="" widths={[360, 720, 960]} sizes="(max-width: 700px) 100vw, 50vw" width={960} format={project.cover.format === 'svg' ? 'svg' : 'webp'} /></a>
  <div class="project-info"><span class="eyebrow">INTERACTIVE WORK</span><Heading><a href={`/projects/${project.slug}/`}>{project.title}<span aria-hidden="true">↗</span></a></Heading><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div><a class="text-link" href={project.playUrl}>开始体验 <span aria-hidden="true">↗</span></a></div>
</article>
